let lang = localStorage.getItem('qalam_lang') || 'kaa';
function t(k){ return (T[lang] && T[lang][k]) || T.kaa[k] || k; }
 
/* STATE (app data) */
let state = loadState();
let curTab = 'agent';
let pendingPlan = null;
let pendingPlanKey = null;
let planName = null;
let authMode = 'login';
 
function loadState(){
  try{
    const r = localStorage.getItem('qalam_state');
    if(r){
      const parsed = JSON.parse(r);
      if(!parsed.users || !parsed.users.length) parsed.users = [ADMIN];
      // Make sure there is always exactly one admin account, and it's ADMIN.
      parsed.users = parsed.users.map(u => u.email === ADMIN.email ? Object.assign({}, ADMIN, {credits: u.credits || 9999}) : Object.assign({}, u, {role: u.role === 'admin' ? 'user' : u.role}));
      if(!parsed.users.find(u => u.email === ADMIN.email)) parsed.users.unshift(ADMIN);
      return parsed;
    }
  }catch(e){}
  return { history: [], generated: 0, users: [ADMIN], payments: [], vipPrices: {w:'30 000', m:'50 000', y:'100 000'} };
}
function saveState(){ try{ localStorage.setItem('qalam_state', JSON.stringify(state)); }catch(e){} }
 
/* SESSION — who is currently logged in on this device */
let user = null;
function getSessionId(){ try{ return localStorage.getItem('qalam_session'); }catch(e){ return null; } }
function setSessionId(id){ try{ localStorage.setItem('qalam_session', id); }catch(e){} }
function clearSessionId(){ try{ localStorage.removeItem('qalam_session'); }catch(e){} }
 
function findUserByEmail(email){
  return state.users.find(u => u.email.toLowerCase() === String(email).toLowerCase());
}
function saveUserRecord(u){
  const i = state.users.findIndex(x => x.id === u.id);
  if(i !== -1) state.users[i] = u; else state.users.push(u);
  saveState();
}
 
/* LANG */
function setLang(l){
  lang = l;
  localStorage.setItem('qalam_lang', l);
  document.querySelectorAll('.lang-btn').forEach(b => b.classList.toggle('active', b.dataset.lang === l));
  if(user) renderTab(); else renderAuth();
  applyModalLang();
}
 
function applyModalLang(){
  const set = (id, v) => { const e = document.getElementById(id); if(e) e.textContent = v; };
  set('t_mTitle', t('mTitle'));
  set('t_mDesc', t('mDesc'));
  set('t_mPay', t('mPay'));
  set('t_mChek', t('mChek'));
  set('t_mChekBtn', t('mChekBtn'));
  set('t_mBtn1', t('mBtn1'));
  set('t_mBtn2', t('mBtn2'));
}
 
function langBarHTML(){
  const langs = [
    {code: 'kaa', name: 'QARAQALPAQ'},
    {code: 'uz', name: "O'ZBEK"},
    {code: 'en', name: 'ENGLISH'},
    {code: 'ru', name: 'РУССКИЙ'}
  ];
  return '<div class="langbar">' + langs.map(l =>
    '<button class="lang-btn' + (l.code === lang ? ' active' : '') + '" data-lang="' + l.code + '" onclick="setLang(\'' + l.code + '\')">' + l.name + '</button>'
  ).join('') + '</div>';
}
 
/* ═══════ AUTH SCREENS (login / register) ═══════ */
function renderAuth(mode){
  if(mode) authMode = mode;
  document.getElementById('bnav').style.display = 'none';
  document.getElementById('profileBtn').style.display = 'none';
  document.getElementById('chip').textContent = '';
 
  const isLogin = authMode === 'login';
  document.getElementById('ws').innerHTML =
    langBarHTML() +
    '<div class="hero">' +
    '<div class="hero-kick">' + t('kick') + '</div>' +
    '<h1>' + t('hh1') + '</h1>' +
    '<p>' + t('hlead') + '</p>' +
    '</div>' +
    '<div class="acard">' +
    '<div class="ahero"><div class="aorbit">✦</div><div><b>' + t('welcome') + '</b><small>Qalam AI</small></div></div>' +
    '<div class="authtabs">' +
    '<button class="' + (isLogin ? 'active' : '') + '" onclick="renderAuth(\'login\')">' + t('authLogin') + '</button>' +
    '<button class="' + (!isLogin ? 'active' : '') + '" onclick="renderAuth(\'register\')">' + t('authRegister') + '</button>' +
    '</div>' +
    (isLogin ?
      ('<label>' + t('fEmail') + '</label><input type="email" id="authEmail" placeholder="you@email.com">' +
       '<label style="margin-top:10px">' + t('fPass') + '</label><input type="password" id="authPass" placeholder="••••••••">' +
       '<button class="arun" onclick="doLogin()">' + t('btnLogin') + '</button>')
      :
      ('<label>' + t('fName') + '</label><input type="text" id="regName" placeholder="' + t('fName') + '">' +
       '<label style="margin-top:10px">' + t('fEmail') + '</label><input type="email" id="regEmail" placeholder="you@email.com">' +
       '<label style="margin-top:10px">' + t('fPass') + '</label><input type="password" id="regPass" placeholder="••••••••">' +
       '<button class="arun" onclick="doRegister()">' + t('btnRegister') + '</button>')
    ) +
    '<div class="autherr" id="authErr"></div>' +
    '<div class="authswitch">' +
    (isLogin ? t('toRegister') + '<b onclick="renderAuth(\'register\')">' + t('authRegister') + '</b>'
              : t('toLogin') + '<b onclick="renderAuth(\'login\')">' + t('authLogin') + '</b>') +
    '</div>' +
    '</div>';
}
 
function showAuthErr(msg){
  const e = document.getElementById('authErr');
  if(!e) return;
  e.textContent = msg;
  e.classList.add('show');
}
 
/* Best-effort device label from the browser's user-agent. This can ONLY see
   logins that happen on THIS device/browser's own storage — there is no
   server, so a login on someone else's phone is invisible here. It's shown
   in the admin panel with that caveat spelled out, not as a real security
   guarantee. */
function deviceLabel(){
  const ua = navigator.userAgent || '';
  let os = 'Noma\'lum qurılma';
  if(/iphone/i.test(ua)) os = 'iPhone';
  else if(/ipad/i.test(ua)) os = 'iPad';
  else if(/android/i.test(ua)){
    const m = ua.match(/;\s*([^;)]+)\s+Build/);
    os = m ? ('Android — ' + m[1].trim()) : 'Android';
  }
  else if(/windows/i.test(ua)) os = 'Windows PC';
  else if(/macintosh/i.test(ua)) os = 'Mac';
  else if(/linux/i.test(ua)) os = 'Linux';
  let browser = '';
  if(/chrome/i.test(ua) && !/edg/i.test(ua)) browser = 'Chrome';
  else if(/safari/i.test(ua) && !/chrome/i.test(ua)) browser = 'Safari';
  else if(/firefox/i.test(ua)) browser = 'Firefox';
  else if(/edg/i.test(ua)) browser = 'Edge';
  return os + (browser ? (' · ' + browser) : '');
}
function logDevice(u){
  if(!u.devices) u.devices = [];
  u.devices.unshift({ label: deviceLabel(), time: new Date().toLocaleString('uz-UZ') });
  u.devices = u.devices.slice(0, 5);
}
 
function doLogin(){
  const email = (document.getElementById('authEmail').value || '').trim();
  const pass = document.getElementById('authPass').value || '';
  if(!email || !pass){ showAuthErr(t('errFill')); return; }
  const found = findUserByEmail(email);
  if(!found || found.pass !== pass){ showAuthErr(t('errInvalid')); return; }
  logDevice(found);
  saveUserRecord(found);
  user = found;
  setSessionId(found.id);
  curTab = 'agent';
  enterApp();
  toast(t('welcome'));
}
 
function doRegister(){
  const name = (document.getElementById('regName').value || '').trim();
  const email = (document.getElementById('regEmail').value || '').trim();
  const pass = document.getElementById('regPass').value || '';
  if(!name || !email || !pass){ showAuthErr(t('errFill')); return; }
  if(findUserByEmail(email)){ showAuthErr(t('errTaken')); return; }
  const newUser = {
    id: 'U-' + Date.now().toString(36) + Math.random().toString(36).slice(2,6),
    name, email, pass,
    role: 'user',      // only the fixed ADMIN account above can ever be 'admin'
    vip: false,
    plan: 'Free', planName: '',
    credits: FREE_CREDITS,
    refCode: 'U' + Math.random().toString(36).slice(2,6).toUpperCase(),
    createdText: new Date().toLocaleString('uz-UZ'),
    devices: [{ label: deviceLabel(), time: new Date().toLocaleString('uz-UZ') }]
  };
  state.users.push(newUser);
  saveState();
  user = newUser;
  setSessionId(newUser.id);
  curTab = 'agent';
  enterApp();
  toast(t('regSuccess'));
  confetti();
}
 
function signOut(){
  clearSessionId();
  user = null;
  authMode = 'login';
  renderAuth();
}
 
function enterApp(){
  document.getElementById('bnav').style.display = 'flex';
  document.getElementById('profileBtn').style.display = 'grid';
  renderTab();
}
 
