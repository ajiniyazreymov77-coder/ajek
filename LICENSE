function renderAcbar(){
  const el = document.getElementById('acbar');
  if(!el || !user) return;
  if(user.vip){
    const label = user.role === 'admin' ? '👑 VIP · ADMIN' : '👑 VIP';
    el.innerHTML = '<div class="crow"><div><b>' + label + '</b><div class="chint">' + t('vipLimit') + '</div></div><div class="cnum">∞</div></div><div class="ctrack"><div class="cfill" style="width:100%"></div></div>';
  } else {
    const pct = Math.max(0, Math.min(100, Math.round((user.credits / FREE_CREDITS) * 100)));
    el.innerHTML = '<div class="crow"><div><b>' + t('limitTitle') + '</b><div class="chint">' + t('limitSub') + '</div></div><div class="cnum">' + user.credits + '</div></div><div class="ctrack"><div class="cfill" style="width:' + pct + '%"></div></div>';
  }
}
 
function updateChip(){
  const chip = document.getElementById('chip');
  if(!chip || !user) return;
  const roleLabel = user.role === 'admin' ? t('roleAdmin') : (user.vip ? t('roleVip') : t('roleUser'));
  chip.textContent = roleLabel + ' · ' + (user.vip ? '∞' : user.credits);
  chip.classList.toggle('vip', !!user.vip);
}
 
/* REFERRAL */
function shareRef(){
  const link = 'https://qalam.app/?ref=' + encodeURIComponent(user.refCode || user.id);
  const text = 'Qalam — AI. ' + link;
  if(navigator.share){ navigator.share({title:'Qalam', text}).catch(()=>{}); }
  else window.open('https://t.me/share/url?url=' + encodeURIComponent(link) + '&text=' + encodeURIComponent(text), '_blank');
}
function copyRef(){
  const link = 'https://qalam.app/?ref=' + encodeURIComponent(user.refCode || user.id);
  if(navigator.clipboard) navigator.clipboard.writeText(link).then(()=>toast(t('copied'))).catch(()=>toast(link));
  else toast(link);
}
 
/* AI — text/JSON generation */
async function callGemini(prompt, jsonMode){
  let lastError = null;
  const key = getApiKey();
  for(const model of GEMINI_MODELS){
    const url = GEMINI_BASE + model + ':generateContent?key=' + key;
    try{
      const body = {
        contents: [{parts: [{text: prompt}]}],
        generationConfig: { temperature: 0.95, topK: 40, topP: 0.95, maxOutputTokens: 8192 }
      };
      if(jsonMode) body.generationConfig.responseMimeType = 'application/json';
      const res = await fetch(url, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
      const data = await res.json();
      if(!res.ok){ lastError = data.error ? data.error.message : ('HTTP ' + res.status); continue; }
      if(!data.candidates || !data.candidates[0]){ lastError = 'Empty response'; continue; }
      return data.candidates[0].content.parts[0].text;
    }catch(err){ lastError = err.message; }
  }
  throw new Error(lastError || t('error_api'));
}
 
/* AI — REAL image generation (Gemini "Nano Banana" image models).
   Returns {mimeType, base64} of an actual generated picture, not a placeholder. */
async function callGeminiImage(prompt){
  let lastError = null;
  const key = getApiKey();
  for(const model of GEMINI_IMAGE_MODELS){
    const url = GEMINI_BASE + model + ':generateContent?key=' + key;
    try{
      const body = { contents: [{ parts: [{ text: prompt }] }] };
      const res = await fetch(url, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(body) });
      const data = await res.json();
      if(!res.ok){ lastError = data.error ? data.error.message : ('HTTP ' + res.status); continue; }
      const parts = data.candidates && data.candidates[0] && data.candidates[0].content && data.candidates[0].content.parts;
      if(!parts){ lastError = 'Empty response'; continue; }
      const imgPart = parts.find(p => p.inlineData || p.inline_data);
      if(!imgPart){ lastError = 'No image in response'; continue; }
      const inline = imgPart.inlineData || imgPart.inline_data;
      return { mimeType: inline.mimeType || inline.mime_type || 'image/png', base64: inline.data };
    }catch(err){ lastError = err.message; }
  }
  throw new Error(lastError || t('error_api'));
}
 
async function runAgent(){
  if(!user) return renderAuth();
  const p = document.getElementById('prompt').value.trim();
  const f = document.getElementById('format').value;
  if(!p){ toast(t('topicEmpty')); return; }
  if(!user.vip && user.credits <= 0){ toast(t('noLimit')); return; }
 
  const r = document.getElementById('result');
  r.innerHTML = '<div class="slides"><div class="ai-loading"><div class="ai-orb"><div class="ai-inner">✦</div></div><b>' + t('loading') + '</b><small>' + t('wait') + '</small><div class="dots"><span></span><span></span><span></span></div></div></div>';
 
  try{
    let html = '';
    let exportHtml = '';
    if(f === 'slides'){
      const s = await makeSlides(p);
      lastGenerated = {format:'slides', topic:p, slides:s.slides};
      exportHtml = exportRowHTML();
      html = '<div class="slides"><div class="notice"><b>✓ ' + s.count + ' ' + t('done') + '</b></div><div class="sgrid">' + s.html + '</div>' + exportHtml + '</div>';
    } else if(f === 'image'){
      const img = await makeImage(p);
      lastGenerated = {format:'image', topic:p, title:img.title, description:img.description, imageDataUrl:img.dataUrl};
      exportHtml = exportRowHTML();
      html = img.html + exportHtml;
    } else {
      const txt = await makeText(p, f);
      lastGenerated = {format:f, topic:p, text:txt};
      exportHtml = exportRowHTML();
      html = '<div class="rbox">QALAM AI\n\n' + txt + '</div>' + exportHtml;
    }
    r.innerHTML = html;
 
    state.generated++;
    state.history.unshift({format: f, prompt: p, time: new Date().toLocaleString('uz-UZ')});
    if(!user.vip){ user.credits = Math.max(0, user.credits - 1); saveUserRecord(user); }
    saveState();
    updateChip();
    renderAcbar();
    confetti();
    toast('✓');
  }catch(err){
    console.error('AI error:', err);
    r.innerHTML = '<div class="slides"><div class="notice err"><b>⚠ ' + t('error') + ':</b><br>' + esc(err.message) + '<br><br>💡 ' + t('aiProblem') + '</div></div>';
    toast(t('error'));
  }
}
 
/* ═══════ REAL FILE EXPORT (PDF / DOCX / PPTX) ═══════
   These build genuine, openable files using small client-side libraries
   loaded from CDN near the end of <body>. Needs an internet connection
   the first time each library loads (browser caches it after that). */
let lastGenerated = null;
 
function exportRowHTML(){
  return '<div class="export-row">' +
    '<button class="prim" onclick="exportPDF()"><span class="ei">📄</span>' + t('exportPDF') + '</button>' +
    '<button onclick="exportWordDoc()"><span class="ei">📝</span>' + t('exportWord') + '</button>' +
    '<button onclick="exportPPTXFile()"><span class="ei">📊</span>' + t('exportPPTX') + '</button>' +
    '</div>';
}
 
function fileBaseName(){
  const topic = (lastGenerated && lastGenerated.topic) || 'material';
  return 'qalam-' + topic.slice(0,24).replace(/[^\p{L}\p{N}]+/gu,'-').replace(/^-+|-+$/g,'') || 'material';
}
 
function generatedBodyText(){
  if(!lastGenerated) return '';
  if(lastGenerated.format === 'slides') return lastGenerated.slides.map((s,i)=>('SLAYD '+(i+1)+'\n'+(s.title||'')+'\n\n'+(s.body||''))).join('\n\n---\n\n');
  if(lastGenerated.format === 'image') return (lastGenerated.title||'') + '\n\n' + (lastGenerated.description||'');
  return lastGenerated.text || '';
}
 
function downloadBlob(blob, filename){
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1500);
}
 
/* Real PDF via jsPDF */
function exportPDF(){
  if(!lastGenerated){ toast(t('error')); return; }
  if(!window.jspdf){ toast('PDF library loading, try again in a sec'); return; }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();
  const marginX = 15; let y = 20; const pageW = 180;
  doc.setFont('helvetica','bold'); doc.setFontSize(16);
  doc.text('QALAM AI — ' + (lastGenerated.topic || ''), marginX, y, {maxWidth: pageW}); y += 12;
  doc.setFont('helvetica','normal'); doc.setFontSize(11);
  const lines = doc.splitTextToSize(generatedBodyText(), pageW);
  lines.forEach(line => {
    if(y > 280){ doc.addPage(); y = 20; }
    doc.text(line, marginX, y); y += 6.5;
  });
  if(lastGenerated.format === 'image' && lastGenerated.imageDataUrl){
    try{ if(y > 180) { doc.addPage(); y = 20; } doc.addImage(lastGenerated.imageDataUrl, 'PNG', marginX, y, 100, 100); }catch(e){}
  }
  doc.save(fileBaseName() + '.pdf');
  toast('PDF ✓');
}
 
/* Real, valid Word file: Word/LibreOffice open HTML content saved with a
   .doc extension and the right MIME type — this is a standard, reliable
   trick (no external Word library needed) and the file opens correctly. */
function exportWordDoc(){
  if(!lastGenerated){ toast(t('error')); return; }
  const bodyText = esc(generatedBodyText()).replace(/\n/g,'<br>');
  const imgTag = (lastGenerated.format === 'image' && lastGenerated.imageDataUrl) ? ('<p><img src="'+lastGenerated.imageDataUrl+'" width="360"></p>') : '';
  const html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">' +
    '<head><meta charset="utf-8"><title>' + esc(lastGenerated.topic||'Qalam') + '</title></head>' +
    '<body style="font-family:Calibri,Arial,sans-serif;font-size:14px">' +
    '<h1>QALAM AI — ' + esc(lastGenerated.topic||'') + '</h1>' + imgTag +
    '<p>' + bodyText + '</p></body></html>';
  const blob = new Blob(['\ufeff', html], {type: 'application/msword'});
  downloadBlob(blob, fileBaseName() + '.doc');
  toast('Word ✓');
}
 
/* Real PPTX via PptxGenJS */
async function exportPPTXFile(){
  if(!lastGenerated){ toast(t('error')); return; }
  if(!window.PptxGenJS){ toast('PPTX library loading, try again in a sec'); return; }
  const pres = new PptxGenJS();
  if(lastGenerated.format === 'slides'){
    lastGenerated.slides.forEach((s,i) => {
      const slide = pres.addSlide();
      slide.background = { color: i % 2 === 0 ? '20233D' : 'FFF6D8' };
      slide.addText(s.title || ('Slayd ' + (i+1)), { x:0.5, y:0.4, w:9, h:1, fontSize:26, bold:true, color: i % 2 === 0 ? 'F5D949' : '20233D' });
      slide.addText(s.body || '', { x:0.5, y:1.6, w:9, h:4.5, fontSize:16, color: i % 2 === 0 ? 'FAF6EC' : '20233D' });
    });
  } else {
    const slide = pres.addSlide();
    slide.addText(lastGenerated.topic || 'Qalam AI', { x:0.5, y:0.4, w:9, h:1, fontSize:26, bold:true, color:'20233D' });
    if(lastGenerated.format === 'image' && lastGenerated.imageDataUrl){
      slide.addImage({ data: lastGenerated.imageDataUrl, x:1, y:1.6, w:5, h:3.5 });
    } else {
      slide.addText(generatedBodyText(), { x:0.5, y:1.6, w:9, h:4.5, fontSize:15, color:'20233D' });
    }
  }
  await pres.writeFile({ fileName: fileBaseName() + '.pptx' });
  toast('PPTX ✓');
}
 
async function makeSlides(topic){
  const langName = t('aiLangName');
  const seed = Math.random().toString(36).slice(2, 10);
  const prompt = 'Sen Qalam AI. 12 ta NOYOB slayd jarat.\n\nMÁHÁM: ' + langName + ' tilinde jaz!\nSEED: ' + seed + '\nTema: "' + topic + '"\n\nJavob FAQAT JSON:\n{"slides":[{"title":"...","body":"..."}]}\n\nFaqat ' + langName + ' tilinde.';
  const text = await callGemini(prompt, true);
  let clean = text.trim().replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/```\s*$/i, '').trim();
  const fb = clean.indexOf('{'), lb = clean.lastIndexOf('}');
  if(fb !== -1 && lb !== -1) clean = clean.substring(fb, lb + 1);
  let res;
  try{ res = JSON.parse(clean); }catch(e){ throw new Error(t('error_json')); }
  if(!res.slides) throw new Error('Slides not found');
  const html = res.slides.map((s, i) => '<div class="slide"><span class="sn">SLAYD ' + (i+1) + ' / ' + res.slides.length + '</span><h3>' + esc(s.title||'') + '</h3><p>' + esc(s.body||'') + '</p></div>').join('');
  return {html, count: res.slides.length, slides: res.slides};
}
 
async function makeText(topic, format){
  const langName = t('aiLangName');
  let prompt = '';
  if(format === 'notes'){
    prompt = 'Sen Qalam AI. "' + topic + '" temasına TEREN KONSPEKT jaz ' + langName + ' tilinde.\n\nTuzılıs:\n📌 KIRISIW\n🔑 TIYAGI TÚSINIKLER\n📖 TIYAGI BÓLIM\n💡 MÁHÁM FAKTLER\n✅ JUWMAQ\n📝 ESLEP QALIW\n\nFaqat ' + langName + ' tilinde!';
  } else if(format === 'report'){
    prompt = 'Sen Qalam AI. "' + topic + '" temasına REFERAT jaz ' + langName + ' tilinde.\n\nTuzılıs:\n1. KIRISIW\n2. TIYAGI BÓLIM\n3. JUWMAQ\n4. ÁDEBIYATLAR\n\nFaqat ' + langName + ' tilinde!';
  } else {
    prompt = 'Sen Qalam AI. "' + topic + '" temasına INFOGRAFIKA teksti jaz ' + langName + ' tilinde.\n\nFormat:\n📊 SARLAVHA\n📈 SANLAR\n🔵 BLOK 1\n🟢 BLOK 2\n🟡 BLOK 3\n🎯 JUWMAQ\n\nFaqat ' + langName + ' tilinde!';
  }
  return await callGemini(prompt, false);
}
 
/* Now generates a REAL AI picture (Gemini image model), not a placeholder
   shape. Falls back to a simple graphic only if the image model fails. */
async function makeImage(topic){
  const langName = t('aiLangName');
  let dataUrl = null, title = topic, description = '';
  try{
    const img = await callGeminiImage('A clear, educational illustration about: ' + topic + '. Clean, colorful, textbook style, no watermark, no text overlay.');
    dataUrl = 'data:' + img.mimeType + ';base64,' + img.base64;
  }catch(e){
    console.error('Image gen failed, using fallback graphic:', e);
  }
  try{
    const capPrompt = 'Sen Qalam AI. "' + topic + '" temasına qısqa súwret dizbesi.\n\nTIL: ' + langName + '\n\nJavob FAQAT JSON:\n{"title":"...","description":"..."}\n\nFaqat ' + langName + '.';
    const text = await callGemini(capPrompt, true);
    let clean = text.trim().replace(/^```json\s*/i,'').replace(/^```\s*/i,'').replace(/```\s*$/i,'').trim();
    const fb = clean.indexOf('{'), lb = clean.lastIndexOf('}');
    if(fb !== -1 && lb !== -1) clean = clean.substring(fb, lb + 1);
    const res = JSON.parse(clean);
    title = res.title || topic; description = res.description || '';
  }catch(e){}
 
  let visual;
  if(dataUrl){
    visual = '<img src="' + dataUrl + '" style="width:100%;height:auto;border-radius:18px;display:block" alt="' + esc(title) + '">';
  } else {
    visual = '<svg viewBox="0 0 400 300" style="width:100%;height:auto;border-radius:18px;background:#F5D94920"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F5D949"/><stop offset="100%" stop-color="#FF6A55"/></linearGradient></defs><circle cx="100" cy="80" r="60" fill="url(#g)" opacity="0.7"/><circle cx="320" cy="220" r="80" fill="#F5D949" opacity="0.5"/><rect x="150" y="100" width="120" height="120" rx="20" fill="#20233D" opacity="0.85"/><text x="210" y="180" font-size="60" text-anchor="middle" fill="#F5D949">🎨</text></svg>';
  }
  const html = '<div class="slides"><div class="notice"><b>✓ AI Súwret</b></div><div style="padding:14px;border-radius:18px;background:rgba(255,253,247,.95)"><div style="font:900 18px Sora;margin-bottom:12px">' + esc(title) + '</div>' + visual + '<div style="margin-top:14px;font-size:13px;color:var(--soft);line-height:1.6">' + esc(description) + '</div></div></div>';
  return { html, title, description, dataUrl };
}
 
function esc(v){ return String(v||'').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m])); }
 
/* TABS */
function renderTab(){
  if(!user) return renderAuth();
  if(curTab === 'agent') renderAgent();
  else if(curTab === 'tools') renderTools();
  else if(curTab === 'history') renderHistory();
  else if(curTab === 'premium') renderPremium();
  syncNav();
}
function tab(x){ curTab = x; renderTab(); }
function syncNav(){ document.querySelectorAll('.bnav-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === curTab)); }
 
