/* PAYMENT MODAL — buying a plan increases the free-limit; it never sets vip/admin */
const PLAN_CREDITS = { planWeek: 120, planMonth: 60, planYear: 99999 };
 
function openModal(plan, price, planKey){
  pendingPlan = plan;
  pendingPlanKey = planKey;
  planName = t(planKey);
  document.getElementById('t_mTitle').textContent = planName + ' — ' + price + ' sóm';
  document.getElementById('t_mDesc').textContent = t('mDesc');
  document.getElementById('modal').classList.add('show');
}
function closeModal(){ document.getElementById('modal').classList.remove('show'); }
function confirmPay(){
  if(!user) return;
  user.plan = pendingPlan;
  user.planName = planName;
  user.subscribedAt = new Date().toLocaleString('uz-UZ');
  if(!user.vip){ user.credits = PLAN_CREDITS[pendingPlanKey] || user.credits; }
  saveUserRecord(user);
  closeModal();
  toast(t('subscribed') + planName);
  confetti();
  renderTab();
}
 
/* PROFILE */
function showProfile(){
  if(!user) return renderAuth();
  const badge = user.role === 'admin' ? t('roleAdmin') : (user.vip ? t('roleVip') : t('roleUser'));
  const initial = (user.name || '?').slice(0,1).toUpperCase();
  const isVip = user.vip;
 
  document.getElementById('ws').innerHTML =
    langBarHTML() +
    '<div class="ph' + (isVip ? ' vip' : '') + '">' +
    '<div class="pa">' +
    (isVip ? '<span class="cr">👑</span>' : '') +
    '<span class="in">' + initial + '</span></div>' +
    '<div class="pn">' + esc(user.name) + '</div>' +
    '<div class="pr">' + badge + (user.planName ? ' · ' + user.planName : '') + '</div>' +
    '<div class="pe">' + esc(user.email) + '</div></div>' +
    '<div class="sgrid2">' +
    '<div class="sc"><span>' + t('plan') + '</span><b>' + (user.planName || 'Free') + '</b></div>' +
    '<div class="sc"><span>' + t('limit') + '</span><b>' + (isVip ? '∞' : user.credits) + '</b></div>' +
    '<div class="sc"><span>' + t('created') + '</span><b>' + state.generated + '</b></div>' +
    '<div class="sc"><span>ID</span><b style="font-size:11px;font-family:monospace">' + esc(user.id) + '</b></div>' +
    '</div>' +
    (user.role === 'admin' ? '<button class="ghost" style="background:#20233D;color:#FAF6EC" onclick="showAdmin()">🔐 ' + t('adminBtn') + '</button>' : '') +
    '<button class="ghost" onclick="goBack()">← ' + t('logout') + '</button>' +
    '<button class="ghost" style="border-color:#c0392b;color:#c0392b" onclick="signOut()">⏻ ' + t('signOut') + '</button>';
}
function goBack(){ curTab = 'agent'; renderTab(); }
 
/* ADMIN — reachable only by the single fixed admin account */
function showAdmin(){
  if(!user || user.role !== 'admin'){ toast(t('errInvalid')); goBack(); return; }
  const users = state.users;
  const vips = users.filter(u => u.vip);
  let list = users.map(u => {
    const a = u.role === 'admin';
    const bc = a ? '#20233D;color:#F5D949' : (u.vip ? 'linear-gradient(135deg,#FFD700,#D4AF37);color:#3d2b00' : '#E4F3F0;color:#565A78');
    const bt = a ? '🔐 ADMIN' : (u.vip ? '👑 VIP' : '👤 USER');
    const devices = u.devices || [];
    const multi = devices.length > 1 ? ' <span style="color:#c0392b;font-weight:900">⚠ ' + devices.length + ' qurılma</span>' : '';
    const devicesHtml = devices.length
      ? '<div style="margin-top:8px;padding:8px 10px;border-radius:10px;background:#fff;border:1px solid var(--line);font-size:10.5px;color:var(--soft)">' +
        devices.map(d => '📱 ' + esc(d.label) + ' — ' + esc(d.time)).join('<br>') + '</div>'
      : '';
    return '<div class="ur"' + (u.vip ? ' style="border-color:#D4AF37;background:linear-gradient(135deg,#fffdf7,#FFF6D8)"' : '') + '>' +
      '<div class="um"><div class="uav"' + (u.vip ? ' style="background:linear-gradient(135deg,#FFD700,#D4AF37);color:#3d2b00"' : '') + '>' + (a ? '👑' : (u.name||'?')[0].toUpperCase()) + '</div>' +
      '<div style="flex:1;min-width:0"><b>' + esc(u.name) + multi + '</b><div class="ue">' + esc(u.email) + '</div>' +
      '<span class="rb" style="background:' + bc + '">' + bt + '</span></div></div>' +
      '<div class="umeta"><span>' + esc(u.id) + '</span><span>' + t('limit') + ': ' + (u.vip ? '∞' : u.credits) + '</span></div>' +
      devicesHtml +
      (a ? '' : '<button class="sbtn ' + (u.vip ? 'no' : 'ok') + '" onclick="toggleVip(\'' + u.id + '\')">' + (u.vip ? '❌ ' + t('removeVip') : '👑 ' + t('makeVip')) + '</button>') +
      '</div>';
  }).join('');
 
  document.getElementById('ws').innerHTML =
    langBarHTML() +
    '<h2 class="wst">🔐 ' + t('adminTitle') + '</h2><p class="wss">' + t('adminSub') + '</p>' +
    '<div class="sgrid2">' +
    '<div class="sc"><span>👥 ' + t('users') + '</span><b>' + users.length + '</b></div>' +
    '<div class="sc" style="background:#FFF6D8"><span>👑 VIP</span><b>' + vips.length + '</b></div>' +
    '<div class="sc"><span>⚡ ' + t('created') + '</span><b>' + state.generated + '</b></div>' +
    '<div class="sc"><span>📊 ' + t('historyTitle') + '</span><b>' + state.history.length + '</b></div>' +
    '</div>' +
 
    '<h3 style="font:900 15px Sora;margin:22px 0 10px">🔑 API Kalit</h3>' +
    '<div class="sc">' +
    '<span>Gemini API kalit</span>' +
    '<input type="text" id="apiKeyInput" value="' + esc(getApiKey()) + '" style="width:100%;margin-top:8px;padding:10px;border:2px solid var(--line);border-radius:10px;font:600 12px monospace;background:#fffdf7">' +
    '<button class="sbtn ok" onclick="saveApiKeyFromAdmin()">💾 Saqlaw</button>' +
    '<div class="chint">Kalitti kod ashpay-aq usı jerden ózgertesiz. Tek usı brauzerde saqlanadı.</div>' +
    '</div>' +
 
    '<h3 style="font:900 15px Sora;margin:22px 0 10px">👥 ' + t('users') + ' (' + users.length + ')</h3>' +
    '<div class="sc" style="margin-bottom:10px;background:#FFE3DD"><span style="color:#c0392b">⚠ Máhám eskertiw</span><b style="font-size:11.5px;font-weight:700;color:#7a2318;display:block;margin-top:4px;line-height:1.5">Bul qurılma dizimi tek usı brauzerde/telefonda kirgen jaǵdaylardı kórsetedi. Bul saytta server joq (barlıq maǵlıwmat telefonıńızdıń ózinde saqlanadı), sonlıqtan basqa adam basqa telefonda sizdiń akkauntıńızǵa kirse, bunı bul jerden kóre almaysız. Haqıйqıy kóp-qurılma tekseriwi ushın server (mısalı Firebase) kerek boladı — soraseniz, sonı sazlap beremen.</b></div>' +
    list +
    '<button class="ghost" onclick="goBack()">← ' + t('profile') + '</button>';
}
function saveApiKeyFromAdmin(){
  const v = (document.getElementById('apiKeyInput').value || '').trim();
  if(!v){ toast(t('errFill')); return; }
  setApiKey(v);
  toast('API kalit saqlandı ✓');
}
function toggleVip(id){
  if(!user || user.role !== 'admin') return;
  const u = state.users.find(x => x.id === id);
  if(!u || u.role === 'admin') return;
  u.vip = !u.vip;
  saveState();
  toast(u.vip ? '👑 ' + u.name : u.name);
  if(u.vip) confetti();
  showAdmin();
}
 
/* UTILS */
function confetti(){
  const c = document.createElement('div'); c.className = 'confetti';
  const cols = ['#F5D949','#FF6A55','#4FB0A5','#20233D','#7a5cc7','#FFD700'];
  for(let i = 0; i < 30; i++){
    const s = document.createElement('span');
    s.style.left = Math.random() * 100 + '%';
    s.style.background = cols[Math.floor(Math.random() * cols.length)];
    s.style.animationDelay = (Math.random() * 0.4) + 's';
    s.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
    c.appendChild(s);
  }
  document.body.appendChild(c);
  setTimeout(() => c.remove(), 3000);
}
let tt;
function toast(m){
  const e = document.getElementById('toast');
  e.textContent = m; e.classList.add('show');
  clearTimeout(tt); tt = setTimeout(() => e.classList.remove('show'), 2400);
}
 
/* PWA install support (works on Android + iPhone "Add to Home Screen").
   manifest.json and sw.js must sit next to this HTML file when you host it. */
if('serviceWorker' in navigator){
  window.addEventListener('load', () => { navigator.serviceWorker.register('sw.js').catch(()=>{}); });
}
 
/* INIT */
(function init(){
  console.log('QALAM V26 — Lang:', lang);
 
  document.querySelectorAll('.lang-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.lang === lang);
  });
  applyModalLang();
 
  const sid = getSessionId();
  if(sid){
    const found = state.users.find(u => u.id === sid);
    if(found){ user = found; enterApp(); return; }
  }
  renderAuth('login');
  console.log('=== READY (logged out) ===');
})();
</script>
</body>
</html>
 



